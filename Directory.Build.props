<?xml version="1.0" encoding="utf-8"?>
<!-- MSBuild props that inject vcpkg include/lib paths for DXC -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VcpkgRoot>$(MSBuildProjectDirectory)\vcpkg_installed\x64-windows</VcpkgRoot>
    <VcpkgIncludePath>$(VcpkgRoot)\include</VcpkgIncludePath>
    <VcpkgLibPath>$(VcpkgRoot)\lib</VcpkgLibPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(VcpkgIncludePath);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(VcpkgLibPath);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>dxcompiler.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
